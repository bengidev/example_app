    },
    {
      "name": "example_app (iPhone Beng - Profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "00008030-0001501E2122202E",
      "flutterMode": "profile"
    },
    {
      "name": "example_app (Android - Debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "console": "debugConsole"
    },
    {
      "name": "example_app (Android - Profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    },
    {
      "name": "example_app (Android - Release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
